@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenSSL)
find_dependency(ZLIB)
find_dependency(Threads)

# No boost here: the public headers do not include boost, and asio/beast are
# compiled into libccapi_core.a. Consumers need only OpenSSL, zlib and Threads.
include("${CMAKE_CURRENT_LIST_DIR}/ccapiTargets.cmake")

check_required_components(ccapi)
