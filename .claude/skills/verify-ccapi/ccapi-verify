SHARED_EXCHANGES="okx binance-usds-futures kucoin"

cmd_changed() {
  local base="" plan_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --plan) plan_only=1; shift ;;
      --base) base="$2"; shift 2 ;;
      *) die "unexpected argument: $1 (usage: changed [--base <ref>] [--plan])" ;;
    esac
  done
  if [ -z "$base" ]; then
    base=$(git -C "$REPO" merge-base HEAD origin/develop 2>/dev/null) || die "no origin/develop; pass --base <ref>"
  fi
  local files
  files=$( { git -C "$REPO" diff --name-only "$base"; git -C "$REPO" ls-files --others --exclude-standard; } | sort -u)
  [ -n "$files" ] || { echo "changed: no changes against $base"; echo "changed_verdict=PASS (nothing to verify)"; return 0; }

  local public; public=$(sed -n '/set(CCAPI_PUBLIC_HEADERS/,/)/p' "$REPO/src/CMakeLists.txt" | grep -o 'include/ccapi_cpp/[a-z_]*\.h')
  declare -A depth=() why=()
  local want_failure=0 want_consumer=0 want_install=0 uncovered=() nolive=() f stem ex
  add_shared() { for ex in $SHARED_EXCHANGES; do depth[$ex]=1; done; want_failure=1; }
  while IFS= read -r f; do
    case "$f" in
      include/ccapi_cpp/service/ccapi_market_data_service_*.h)
        stem=${f#include/ccapi_cpp/service/ccapi_market_data_service_}; stem=${stem%.h}
        if [ "$stem" = ccapi_market_data_service ]; then add_shared; else
          for ex in $(stem_exchanges "$stem"); do depth[$ex]=1; done; fi
        why[$f]="market-data service" ;;
      include/ccapi_cpp/service/ccapi_market_data_service.h|include/ccapi_cpp/service/ccapi_service.h)
        add_shared; why[$f]="shared service code" ;;
      include/ccapi_cpp/service/ccapi_execution_management_service*|include/ccapi_cpp/service/ccapi_fix_service*)
        uncovered+=("$f (execution/FIX: needs credentials, not driven by this harness)") ;;
      include/ccapi_cpp/*.h)
        if echo "$public" | grep -qx "$f"; then want_consumer=1; want_install=1; why[$f]="public header"; else why[$f]="internal header"; fi
        add_shared ;;
      src/ccapi_session.cpp) add_shared; want_consumer=1; why[$f]="library source" ;;
      src/CMakeLists.txt|src/ccapiConfig.cmake.in) add_shared; want_consumer=1; want_install=1; why[$f]="library build/packaging" ;;
      trade/*) depth[okx]=1; why[$f]="subscriber driver" ;;
      .claude/skills/verify-ccapi/*) depth[okx]=1; want_failure=1; want_consumer=1; want_install=1; why[$f]="harness itself" ;;
      *) nolive+=("$f") ;;
    esac
  done <<< "$files"

  local id dir; id=$(run_id changed); dir="$ART/$id"; mkdir -p "$dir"
  {
    echo "# ccapi-verify changed"
    echo; echo "- base: \`$(git -C "$REPO" rev-parse --short "$base")\`, head: \`$(git -C "$REPO" rev-parse --short HEAD)\`, uncommitted tracked files: $(git -C "$REPO" status --porcelain --untracked-files=no | wc -l)"
    echo; echo "## Plan"
    for ex in "${!depth[@]}"; do echo "- market-depth on \`$ex\`$( [ -z "$(depth_args "$ex")" ] && echo ' — no recipe, UNCOVERED')"; done | sort
    [ $want_failure -eq 1 ] && echo "- subscription-failure on \`okx\`"
    [ $want_consumer -eq 1 ] && echo "- consumer (build tree)"
    [ $want_install -eq 1 ] && echo "- consumer-install (installed, boost hidden)"
    for f in "${uncovered[@]}"; do echo "- UNCOVERED: $f"; done
    for f in "${nolive[@]}"; do echo "- no live check: \`$f\`"; done
  } > "$dir/summary.md"
  cat "$dir/summary.md"
  [ $plan_only -eq 1 ] && { echo; echo "plan_only=1 summary=$dir/summary.md"; return 0; }

  local fails=0 incomplete=${#uncovered[@]} out rd verdict exs=()
  record() { # $1 label, $2 rc, $3 output
    rd=$(echo "$3" | sed -n 's/^run_dir=//p' | tail -1)
    verdict=$(echo "$3" | grep -E '^verdict=|^reason=' | tr '\n' ' ')
    echo "- $1 → ${verdict:-harness error rc=$2} \`${rd#$REPO/}\`" >> "$dir/results.md"
    [ "$2" -eq 0 ] || fails=$((fails + 1))
  }
  : > "$dir/results.md"
  out=$(cmd_build 2>&1); local rc=$?
  echo "$out" | tail -1
  if [ $rc -ne 0 ]; then echo "- build → FAIL" >> "$dir/results.md"; fails=$((fails + 1)); else
    for ex in "${!depth[@]}"; do [ -n "$(depth_args "$ex")" ] && exs+=("$ex"); done
    out=$(cmd_doctor "${exs[@]}" 2>&1); echo "$out" > "$dir/doctor.txt"
    for ex in "${!depth[@]}"; do
      if [ -z "$(depth_args "$ex")" ]; then echo "- market-depth \`$ex\` → UNCOVERED (no recipe in depth_args)" >> "$dir/results.md"; incomplete=$((incomplete + 1)); continue; fi
      if echo "$out" | grep -q "^net $ex: UNREACHABLE"; then echo "- market-depth \`$ex\` → NOT VERIFIED (network unreachable)" >> "$dir/results.md"; incomplete=$((incomplete + 1)); continue; fi
      local o; o=$(cmd_drive market-depth exchange="$ex" field=MARKET_DEPTH market_depth_max=5 $(depth_args "$ex") 2>&1); rc=$?
      record "market-depth \`$ex\`" $rc "$o"
    done
    if [ $want_failure -eq 1 ]; then o=$(cmd_drive subscription-failure exchange=okx symbol=NOPE-USDT field=MARKET_DEPTH market_depth_max=5 duration_seconds=6 --expect failure 2>&1); record "subscription-failure \`okx\`" $? "$o"; fi
    if [ $want_consumer -eq 1 ]; then o=$(consumer_run tree okx BTC-USDT 2>&1); record "consumer (build tree)" $? "$o"; fi
    if [ $want_install -eq 1 ]; then o=$(consumer_run install okx BTC-USDT 2>&1); record "consumer-install" $? "$o"; fi
  fi
  for f in "${uncovered[@]}"; do echo "- UNCOVERED: $f" >> "$dir/results.md"; done
  local final=PASS; [ $incomplete -gt 0 ] && final=INCOMPLETE; [ $fails -gt 0 ] && final=FAIL
  { echo; echo "## Results"; sort "$dir/results.md"; echo; echo "changed_verdict=$final"; } >> "$dir/summary.md"
  rm -f "$dir/results.md"
  echo; sed -n '/^## Results/,$p' "$dir/summary.md"; echo "summary=$dir/summary.md"
  case $final in PASS) return 0 ;; FAIL) return 1 ;; *) return 3 ;; esac
}

cmd_cleanup() {
  local killed=0
  if [ -d "$ART" ]; then
    while IFS= read -r pf; do
      local pid; pid=$(cat "$pf")
      if kill -0 "$pid" 2>/dev/null; then kill "$pid" && killed=$((killed + 1)); fi
      rm -f "$pf"
    done < <(find "$ART" -name pid -type f)
  fi
  rm -rf "$SCRATCH"
  echo "cleanup: killed=$killed scratch_removed=$SCRATCH artifacts_kept=$ART"
}

case "${1:-help}" in
  build) shift; cmd_build "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  drive) shift; cmd_drive "$@" ;;
  consumer) shift; cmd_consumer "$@" ;;
  consumer-install) shift; cmd_consumer_install "$@" ;;
  changed) shift; cmd_changed "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
